#!/usr/bin/env bash
# review-load — Who has how many pending reviews on open PRs?
#
# Usage: review-load [-m | -d | -p] [-o org]... [-r owner/repo]... [-t team.txt] [--drafts]
#        review-load -a LOGIN...
#   (none)       pending reviews count per team member
#   -m           my pending reviews, with a link to each PR
#   -d           every team member's pending reviews, with links
#   -p           status of my own open PRs: draft, approved, changes requested,
#                pending reviewers, CI, conflicts
#   -a LOGIN     add one or more people to my team list
#                e.g. review-load -a pseudo1 pseudo2
#   -o ORG       restrict to an organization (repeatable)  e.g. -o glpi
#                shortcuts: glpi = glpi-project/glpi repository (the core),
#                           plugins = pluginsGLPI + glpi-network
#                default (no -o nor -r): plugins
#   -r REPO      restrict to a repository (repeatable)     e.g. -r pluginsGLPI/fields
#   -t FILE      team list of GitHub logins (one per line, # = comment)
#                default: $REVIEW_LOAD_TEAM, else ~/.config/review-load/team.txt
#   --drafts     include draft PRs (excluded by default)
#
# Requirements: gh (authenticated with `gh auth login`) and jq.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
TEAM_FILE="${REVIEW_LOAD_TEAM:-}"
if [[ -z "$TEAM_FILE" ]]; then
    TEAM_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/review-load/team.txt"
fi
SCOPE=()
DETAILS=0
ME=0
DRAFTS=0
ADD=()
MINE=0
PLUGIN_ORGS=(pluginsGLPI glpi-network)

org_alias() {
    case "$1" in
        glpi) echo "glpi-project" ;;
        *) echo "$1" ;;
    esac
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t) TEAM_FILE="$2"; shift 2 ;;
        -o)
            if [[ "$2" == plugins ]]; then
                for o in "${PLUGIN_ORGS[@]}"; do SCOPE+=("org:$o"); done
            elif [[ "$2" == glpi ]]; then
                SCOPE+=("repo:glpi-project/glpi")
            else
                SCOPE+=("org:$(org_alias "$2")")
            fi
            shift 2 ;;
        -r) SCOPE+=("repo:$(org_alias "${2%%/*}")/${2#*/}"); shift 2 ;;
        -d) DETAILS=1; shift ;;
        -m) ME=1; DETAILS=1; shift ;;
        -p) MINE=1; shift ;;
        -a)
            shift
            while [[ $# -gt 0 && "$1" != -* ]]; do ADD+=("$1"); shift; done
            [[ ${#ADD[@]} -gt 0 ]] || { echo "Usage: review-load -a LOGIN..." >&2; exit 1; } ;;
        --drafts) DRAFTS=1; shift ;;
        -h|--help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "Unknown option: $1" >&2; exit 1 ;;
    esac
done

command -v gh >/dev/null || { echo "gh not found" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq not found" >&2; exit 1; }

if [[ ${#ADD[@]} -gt 0 ]]; then
    mkdir -p "$(dirname "$TEAM_FILE")"
    touch "$TEAM_FILE"
    for login in "${ADD[@]}"; do
        # Check the account exists and get the exact spelling of the login
        if ! real=$(gh api "users/$login" --jq .login 2>/dev/null); then
            echo "❌ $login: GitHub account not found" >&2
            continue
        fi
        if sed -e 's/#.*//' -e 's/[[:space:]]//g' "$TEAM_FILE" | grep -qixF "$real"; then
            echo "ℹ️  $real is already in the list"
        else
            [[ ! -s "$TEAM_FILE" || -z "$(tail -c1 "$TEAM_FILE")" ]] || echo >> "$TEAM_FILE"
            echo "$real" >> "$TEAM_FILE"
            echo "✅ $real added"
        fi
    done
    echo "📝 $TEAM_FILE"
    exit 0
fi

# Warn when a newer version is on GitHub (only for a copy installed with install.sh)
check_update() {
    local info="$SCRIPT_DIR/install.info" REPO REF SHA latest
    [[ -f "$info" ]] || return 0
    REPO=$(sed -n 's/^REPO=//p' "$info")
    REF=$(sed -n 's/^REF=//p' "$info")
    SHA=$(sed -n 's/^SHA=//p' "$info")
    latest=$(gh api "repos/$REPO/commits/$REF" --jq .sha 2>/dev/null) || return 0
    [[ -z "$latest" || "$latest" == "$SHA" ]] && return 0
    {
        echo
        echo "⚠️  A new version of review-load is available. To update:"
        echo "    gh api repos/$REPO/contents/install.sh -H 'Accept: application/vnd.github.raw' | bash"
    } >&2
}
trap check_update EXIT

if [[ $ME -eq 0 && $MINE -eq 0 ]]; then
    [[ -f "$TEAM_FILE" ]] || { echo "Team file not found: $TEAM_FILE (one GitHub login per line)" >&2; exit 1; }
    mapfile -t MEMBERS < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$TEAM_FILE" | grep -v '^$')
    [[ ${#MEMBERS[@]} -gt 0 ]] || { echo "No member in $TEAM_FILE: add one GitHub login per line." >&2; exit 1; }
fi

# user-review-requested = direct request still pending (gone as soon as the review is submitted)
BASE="is:pr is:open archived:false"
[[ $DRAFTS -eq 1 ]] || BASE+=" draft:false"
if [[ ${#SCOPE[@]} -eq 0 ]]; then
    for o in "${PLUGIN_ORGS[@]}"; do SCOPE+=("org:$o"); done
fi
BASE+=" ${SCOPE[*]}"

TTY=false
[[ -t 1 ]] && TTY=true

# GitHub search sometimes times out internally and silently returns only part of the results:
# search for the PR ids only (cheap), two or three times, and merge the attempts
search_ids() {
    local q="$1" ids='[]' count=0 attempt json
    for attempt in 1 2 3; do
        json=$(gh api graphql -f q="$q" -f query='
            query($q: String!) {
              search(query: $q, type: ISSUE, first: 100) { issueCount nodes { ... on PullRequest { id } } }
            }')
        count=$(jq --argjson c "$count" '[.data.search.issueCount, $c] | max' <<<"$json")
        ids=$(jq -c --argjson ids "$ids" '$ids + [.data.search.nodes[].id] | unique' <<<"$json")
        # the total count can be wrong too: always merge at least two attempts
        [[ $attempt -ge 2 && $(jq length <<<"$ids") -ge $count ]] && break
    done
    [[ $(jq length <<<"$ids") -ge $count ]] || echo "⚠️  GitHub search returned incomplete results, some PRs may be missing: run again." >&2
    echo "$ids"
}

LEGEND="🔁 changes requested  🚀 ready to merge  ✅ approved  👀 waiting for review  ❔ no reviewer  📝 draft
💬 commented  ⏳ pending  ↻ re-requested after requesting changes  Nd = days without activity"

# One line per PR: PRs of $3 (mode "mine"), or PRs awaiting the review of $3 (mode "review"
# for me, "team" for someone else)
pr_lines() {
    local mode="$1" who="$3" ids
    ids=$(search_ids "$2")
    # Details fetched by id, outside the search: reliable
    jq -n --argjson ids "$ids" --arg query '
        query($ids: [ID!]!) {
          nodes(ids: $ids) {
            ... on PullRequest {
              number title url isDraft mergeable mergeStateStatus reviewDecision updatedAt
              author { login }
              repository { nameWithOwner viewerPermission }
              reviewRequests(first: 20) {
                nodes { requestedReviewer { __typename ... on User { login } } }
              }
              latestOpinionatedReviews(first: 30) { nodes { state author { login } } }
              latestReviews(first: 30) { nodes { state author { login } } }
              commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
            }
          }
        }' '{query: $query, variables: {ids: $ids}}' \
    | gh api graphql --input - \
    | jq -r --argjson tty "$TTY" --arg mode "$mode" --arg me "$who" '
        # Reviewer states, ignoring the reviews of the PR author:
        # - decisive state = latest APPROVED / CHANGES_REQUESTED review (a later comment keeps it)
        # - a reviewer currently requested again counts as pending, not on their old review
        def reviewers:
            .author.login as $author
            # a team name would need the read:org scope, so teams are shown generically
            | [.reviewRequests.nodes[].requestedReviewer | .login // "a team"] as $pending
            | [.latestOpinionatedReviews.nodes[] | select(.author.login != $author)] as $op
            | {
                pending: $pending,
                rerequested: [$op[] | select(.state == "CHANGES_REQUESTED") | .author.login | select(IN($pending[]))],
                approved: [$op[] | select(.state == "APPROVED") | .author.login | select(IN($pending[]) | not)],
                changes: [$op[] | select(.state == "CHANGES_REQUESTED") | .author.login | select(IN($pending[]) | not)],
                commented: [.latestReviews.nodes[] | select(.state == "COMMENTED") | .author.login
                            | select(. != $author and (IN($op[].author.login) | not) and (IN($pending[]) | not))]
              };
        # Same rule as the GitHub merge button: merge permission and a clean merge state
        # (only meaningful for the viewer: not shown in the team view)
        def ready:
            $mode != "team"
            and (.isDraft | not)
            and (.repository.viewerPermission | IN("WRITE", "MAINTAIN", "ADMIN"))
            and ((.mergeStateStatus | IN("CLEAN", "HAS_HOOKS"))
                 or (.mergeStateStatus == "BEHIND" and (.reviewDecision | IN("APPROVED", null))));
        def status:
            if .isDraft then [5, "📝"]
            elif (.rv.changes | length > 0) then [0, "🔁"]
            elif ready then [1, "🚀"]
            # still blocked by a reviewer who requested changes: waiting on them
            elif (.rv.rerequested | length > 0) then [3, "👀"]
            elif (.rv.approved | length > 0) or .reviewDecision == "APPROVED" then [2, "✅"]
            elif (.rv.pending | length > 0) then [3, "👀"]
            else [4, "❔"] end;
        def days: (now - (.updatedAt | fromdateiso8601)) / 86400 | floor;
        def ci:
            {"SUCCESS": "CI ✅", "FAILURE": "CI ❌", "ERROR": "CI ❌", "PENDING": "CI ⏳", "EXPECTED": "CI ⏳"}[.commits.nodes[0].commit.statusCheckRollup.state // ""];
        def part($t; $l): if ($l | length) > 0 then "\($t) \($l | join(","))" else empty end;
        def sp($n): if $n > 0 then " " * $n else "" end;
        def pad($n): . + sp($n - length);
        def cut($n): if length > $n then .[0:$n - 1] + "…" else . end;
        # clickable link in terminals that support OSC 8, plain text otherwise
        def link($url): if $tty then "\u001b]8;;\($url)\u001b\\\(.)\u001b]8;;\u001b\\" else . end;

        if .data.nodes == null then
            "Error: \(.errors[0].message // "unexpected GitHub response")\n" | halt_error(1)
        else . end
        | {issueCount: (.data.nodes | length), nodes: .data.nodes} as $s
        | ($s.nodes | map(. + {rv: reviewers, ref: "\(.repository.nameWithOwner)#\(.number)", by: "@\(.author.login)"} | . + {st: status})) as $prs
        | ([$prs[].ref | length] | max // 0) as $w
        | ([$prs[].by | length] | max // 0) as $wa
        | (if $mode == "mine" then "My open PRs — \($s.issueCount)" else "\($me) — \($s.issueCount) pending review(s)" end),
          ($prs
            # my PRs: grouped by status; reviews to do: the longest waiting first
            | (if $mode == "mine" then sort_by(.st[0]) else sort_by(.updatedAt) end) | .[]
            | .url as $u
            | .rv.rerequested as $rr
            | "\(.st[1]) \(.ref | link($u))\(sp($w - (.ref | length) + 2))\(.title | cut(45) | pad(45))  "
              + (if $mode != "mine" then (.by | pad($wa)) + "  " else "" end)
              + ("\(days)d" | pad(4)) + "  "
              + ([ part("✅"; .rv.approved),
                   part("🔁"; .rv.changes),
                   part("💬"; .rv.commented),
                   # in my review list, I am obviously pending: only show the others
                   part("⏳"; [.rv.pending[] | select($mode == "mine" or . != $me) | if IN($rr[]) then . + "↻" else . end]),
                   (ci // empty),
                   (if .mergeable == "CONFLICTING" then "⚠️ conflicts" else empty end)
                 ] | join("  ")))
        '
}

if [[ $MINE -eq 1 || $ME -eq 1 ]]; then
    VIEWER=$(gh api user --jq .login)
    if [[ $MINE -eq 1 ]]; then
        # Drafts included: we want to see all our open PRs
        pr_lines mine "is:pr is:open archived:false author:$VIEWER ${SCOPE[*]}" "$VIEWER"
    else
        pr_lines review "$BASE user-review-requested:$VIEWER" "$VIEWER"
    fi
    printf '\n%s\n' "$LEGEND"
    exit 0
fi

RESULTS=""
declare -A JSON
for login in "${MEMBERS[@]}"; do
    JSON[$login]=$(gh api -X GET search/issues \
        -f q="$BASE user-review-requested:$login" \
        -f per_page=100 -f sort=created -f order=asc)
    RESULTS+="$(jq '.total_count' <<<"${JSON[$login]}")"$'\t'"$login"$'\n'
done
SORTED=$(printf '%s' "$RESULTS" | sort -t$'\t' -k1,1nr -k2,2)

if [[ $DETAILS -eq 0 ]]; then
    while IFS=$'\t' read -r c l; do
        printf '%-20s %3d\n' "$l" "$c"
    done <<<"$SORTED"
    exit 0
fi

# Same lines as -m, for every team member
first=1
while IFS=$'\t' read -r c l; do
    [[ $first -eq 1 ]] || echo
    first=0
    pr_lines team "$BASE user-review-requested:$l" "$l"
done <<<"$SORTED"
printf '\n%s\n' "$LEGEND"
exit 0
